{
  "manifest_version": 3,
  "name": "SOCKS5 Proxy",
  "version": "1.1.0",
  "description": "通过 socks5://ip:port 代理网页流量，支持多服务器配置",
  "permissions": [
    "proxy",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SOCKS5 代理设置"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}