{
  "manifest_version": 3,
  "name": "SOCKS5 Proxy",
  "version": "1.3.0",
  "description": "按标签页控制 SOCKS5 代理",
  "permissions": ["proxy", "storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SOCKS5 代理"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": { "128": "icons/icon128.png" }
}